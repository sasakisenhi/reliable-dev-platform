{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliable-dev-platform.local/schemas/application-contract.schema.json",
  "title": "Self-Healing Application Contract",
  "description": "Developer-owned contract automatically reused for initial and recovery checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationId",
    "expectedInstances",
    "representativeOperation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "applicationId": {
      "type": "string",
      "minLength": 1
    },
    "expectedInstances": {
      "type": "integer",
      "minimum": 1
    },
    "representativeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeoutSeconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
